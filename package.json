{
  "name": "graphviz-diagram-preview",
  "version": "0.1.0",
  "displayName": "Graphviz Diagram Preview",
  "description": "Adds Graphviz (DOT) support to VS Code's built-in Markdown preview",
  "keywords": [
    "graphviz",
    "dot",
    "diagram",
    "graph",
    "markdown",
    "markdown-preview",
    "wasm"
  ],
  "icon": "media/icon.png",
  "publisher": "ReoX86",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Reonarudo/graphviz-markdown-preview.git"
  },
  "bugs": {
    "url": "https://github.com/Reonarudo/graphviz-markdown-preview/issues"
  },
  "homepage": "https://github.com/Reonarudo/graphviz-markdown-preview#readme",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "media/preview.css"
    ]
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.3",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "4.0.0",
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.28.2",
    "markdown-it": "15.0.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign@2.1.0": true
  }
}
